ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=van_uyen_db
# For Python running on the host. Docker Compose supplies the internal postgres hostname.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/van_uyen_db
SECRET_KEY=development-only-change-this-secret-key-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=uploads
# Browser URL for the frontend container; leave empty for LocalStorage-only mode.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
